<mxfile host="app.diagrams.net" version="24.0.0" type="device"><diagram id="master_arch" name="Master System Architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1280" pageHeight="720"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="banner" value="Zero-Trust Peer-to-Peer File Sharing Swarm &amp;bull; End-to-End System Architecture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#020617;fontStyle=1;fontSize=16;fontColor=#ffffff;align=center;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1200" height="45" as="geometry" /></mxCell><mxCell id="z1" value="1. Participating Clients (Zero-Install)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0284c7;fontStyle=1;fontSize=13;startSize=30;fontColor=#0369a1;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="85" width="230" height="480" as="geometry" /></mxCell><mxCell id="c_phone" value="📱 Mobile Phone / Tablet&#10;(Instant Browser Hub)&#10;&amp;bull; Join via QR Code scan&#10;&amp;bull; Zero app installation&#10;&amp;bull; Ephemeral Key Identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1e3a8a;" parent="z1" vertex="1"><mxGeometry x="15" y="45" width="200" height="120" as="geometry" /></mxCell><mxCell id="c_laptop" value="💻 Laptop / Workstation&#10;(Full Host or Client)&#10;&amp;bull; Streamlit Command UI&#10;&amp;bull; Persistent RSA Keypair&#10;&amp;bull; Auto Wi-Fi Seeding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1e3a8a;" parent="z1" vertex="1"><mxGeometry x="15" y="190" width="200" height="120" as="geometry" /></mxCell><mxCell id="c_cli" value="🖥️ Headless Node&#10;(Native Python CLI Daemon)&#10;&amp;bull; Server / Cloud peer&#10;&amp;bull; High-throughput transfers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#1e3a8a;" parent="z1" vertex="1"><mxGeometry x="15" y="335" width="200" height="110" as="geometry" /></mxCell><mxCell id="z2" value="2. Discovery &amp; Transport Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;fontStyle=1;fontSize=13;startSize=30;fontColor=#7e22ce;rounded=1;" parent="1" vertex="1"><mxGeometry x="310" y="85" width="240" height="480" as="geometry" /></mxCell><mxCell id="net_beacon" value="📡 LAN Auto-Discovery&#10;(UDP Port 50050 Multicast)&#10;&amp;bull; Broadcasts every 3s&#10;&amp;bull; Instant local peer mesh&#10;&amp;bull; Zero manual IP setup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#581c87;" parent="z2" vertex="1"><mxGeometry x="15" y="45" width="210" height="120" as="geometry" /></mxCell><mxCell id="net_gtw" value="🌐 Web Gateway Bridge&#10;(Streamlit Port 8500)&#10;&amp;bull; HTTP / WebSocket host&#10;&amp;bull; QR Code generator&#10;&amp;bull; Browser &amp;rarr; TCP converter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#581c87;" parent="z2" vertex="1"><mxGeometry x="15" y="190" width="210" height="120" as="geometry" /></mxCell><mxCell id="net_wire" value="⚡ Length-Prefixed Wire Framer&#10;(TCP Stream Parser)&#10;&amp;bull; 4-byte big-endian header&#10;&amp;bull; 16 MB chunk ceiling&#10;&amp;bull; DoS / buffer overflow guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#581c87;" parent="z2" vertex="1"><mxGeometry x="15" y="335" width="210" height="110" as="geometry" /></mxCell><mxCell id="z3" value="3. Zero-Trust Security &amp; Engine Core" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;fontSize=13;startSize=30;fontColor=#15803d;rounded=1;" parent="1" vertex="1"><mxGeometry x="590" y="85" width="340" height="480" as="geometry" /></mxCell><mxCell id="eng_crypto" value="🔐 Identity &amp; Envelope Signer&#10;&amp;bull; 2048-bit RSA-PSS (SHA-256, MGF1)&#10;&amp;bull; Replay defense: 60s window + nonce filter&#10;&amp;bull; Every P2P envelope cryptographically signed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#10b981;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#065f46;" parent="z3" vertex="1"><mxGeometry x="15" y="45" width="310" height="100" as="geometry" /></mxCell><mxCell id="eng_merkle" value="🛡️ In-Memory RFC 6962 Merkle Verifier&#10;&amp;bull; Discrete 64 KB chunk verification&#10;&amp;bull; 0x00 leaf / 0x01 internal node domain separation&#10;&amp;bull; Odd-node promotion (CVE-2012-2459 duplicate bug fix)&#10;&amp;bull; 0 Bytes written to disk before root match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#10b981;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#065f46;" parent="z3" vertex="1"><mxGeometry x="15" y="165" width="310" height="135" as="geometry" /></mxCell><mxCell id="eng_rep" value="⚖️ Dynamic Peer Reputation &amp; Quarantine&#10;&amp;bull; Initial Score: 50 | Range: 0 to 100&#10;&amp;bull; Reward: +2 per honest chunk delivery&#10;&amp;bull; Penalty: -25 per detected corruption&#10;&amp;bull; File Quarantine Q(Peer, File)=1 prevents re-attacks&#10;&amp;bull; Permanent socket blacklist when score = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#10b981;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#065f46;" parent="z3" vertex="1"><mxGeometry x="15" y="320" width="310" height="135" as="geometry" /></mxCell><mxCell id="z4" value="4. Storage &amp; State Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontStyle=1;fontSize=13;startSize=30;fontColor=#b45309;rounded=1;" parent="1" vertex="1"><mxGeometry x="970" y="85" width="270" height="480" as="geometry" /></mxCell><mxCell id="store_ram" value="🧠 Volatile RAM Buffer&#10;(Pre-Commit Barrier)&#10;&amp;bull; Holds chunk during hashing&#10;&amp;bull; Instantly zeroed if corrupt&#10;&amp;bull; Protects local SSD/HDD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#92400e;" parent="z4" vertex="1"><mxGeometry x="15" y="45" width="240" height="110" as="geometry" /></mxCell><mxCell id="store_disk" value="💾 Verified Clean Storage&#10;(Local Disk Directory)&#10;&amp;bull; Chunks assembled into final file&#10;&amp;bull; 100% cryptographic integrity&#10;&amp;bull; Immediate re-seeding enabled" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f0fdf4;strokeColor=#10b981;fontStyle=1;fontSize=11;fontColor=#065f46;" parent="z4" vertex="1"><mxGeometry x="15" y="180" width="240" height="125" as="geometry" /></mxCell><mxCell id="store_db" value="📊 SQLite Trust Database&#10;(WAL Mode Persistence)&#10;&amp;bull; Peer identity &amp; IP ledger&#10;&amp;bull; Real-time reputation metrics&#10;&amp;bull; Audit trail of all transfers" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#eff6ff;strokeColor=#3b82f6;fontStyle=1;fontSize=11;fontColor=#1e3a8a;" parent="z4" vertex="1"><mxGeometry x="15" y="330" width="240" height="125" as="geometry" /></mxCell><mxCell id="e1" value="HTTP / WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="c_phone" target="net_gtw" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Browser Hub" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="c_laptop" target="net_gtw" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Raw TCP Socket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="c_cli" target="net_wire" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Local Dispatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="net_gtw" target="net_wire" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Discovers Peers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeWidth=1.5;strokeColor=#64748b;fontSize=10;fontColor=#475569;" parent="1" source="net_beacon" target="c_laptop" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Decoded Envelopes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="net_wire" target="eng_crypto" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Validated Chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="eng_crypto" target="eng_merkle" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Pre-Commit RAM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeWidth=1.5;strokeColor=#64748b;fontSize=10;fontColor=#475569;" parent="1" source="eng_merkle" target="store_ram" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="Commit Clean Chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="eng_merkle" target="store_disk" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Verification Outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="eng_merkle" target="eng_rep" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="Sync Trust Scores" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#1e293b;" parent="1" source="eng_rep" target="store_db" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>