<mxfile host="app.diagrams.net" version="24.0.0" type="device"><diagram id="master_sec" name="Master Security &amp; Reputation Lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1280" pageHeight="720"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="banner" value="Zero-Trust File Verification &amp; Dynamic Peer Reputation Lifecycle (With Anti-Framing Defense)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#020617;fontStyle=1;fontSize=16;fontColor=#ffffff;align=center;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1200" height="45" as="geometry" /></mxCell><mxCell id="s1" value="1. File Ingestion &amp; Blueprint&#10;&amp;bull; File split into 64 KB discrete chunks&#10;&amp;bull; RFC 6962 Domain-Separated Merkle Tree&#10;&amp;bull; Odd-node promotion (CVE-2012-2459 fix)&#10;&amp;bull; File Merkle Root R_F published to swarm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="40" y="90" width="270" height="110" as="geometry" /></mxCell><mxCell id="s2" value="2. P2P Chunk Transfer&#10;&amp;bull; Provider sends Chunk C_k + Merkle Proof&#10;&amp;bull; Mandatory Provider Signed Receipt &amp;Sigma;_prov&#10;&amp;bull; Cryptographic non-repudiation established" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1e3a8a;" parent="1" vertex="1"><mxGeometry x="350" y="90" width="270" height="110" as="geometry" /></mxCell><mxCell id="s3" value="3. Pre-Commit In-Memory Barrier (RAM)&#10;&amp;bull; Chunk staged in volatile RAM buffer ONLY&#10;&amp;bull; ZERO BYTES written to disk before audit&#10;&amp;bull; Full protection against drive poisoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#9333ea;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#581c87;" parent="1" vertex="1"><mxGeometry x="660" y="90" width="280" height="110" as="geometry" /></mxCell><mxCell id="s4" value="RFC 6962 Audit:&#10;Reconstructed Root&#10;== File Root R_F?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#78350f;" parent="1" vertex="1"><mxGeometry x="990" y="90" width="210" height="110" as="geometry" /></mxCell><mxCell id="v1" value="✅ VALID CHUNK VERIFIED&#10;&amp;bull; Commit chunk from RAM to Disk&#10;&amp;bull; File reconstructs with 100% integrity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#10b981;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#065f46;" parent="1" vertex="1"><mxGeometry x="720" y="260" width="230" height="80" as="geometry" /></mxCell><mxCell id="v2" value="⭐ REPUTATION REWARD: +2&#10;&amp;bull; Provider Score climbs toward 100&#10;&amp;bull; Node elevated to &quot;Trusted Seeder&quot;&#10;&amp;bull; Priority selection in swarm rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#10b981;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#065f46;" parent="1" vertex="1"><mxGeometry x="720" y="370" width="230" height="80" as="geometry" /></mxCell><mxCell id="c1" value="❌ CORRUPT / TAMPERED DETECTED&#10;&amp;bull; Volatile RAM buffer immediately PURGED&#10;&amp;bull; 0 Bytes written to secondary storage&#10;&amp;bull; Zero disk contamination achieved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#7f1d1d;" parent="1" vertex="1"><mxGeometry x="980" y="260" width="250" height="80" as="geometry" /></mxCell><mxCell id="c2" value="🚫 LOCAL ISOLATION &amp; PENALTY&#10;&amp;bull; Targeted Quarantine: Q(Provider, File) = 1&#10;&amp;bull; Reputation Score penalized: -25&#10;&amp;bull; Score &amp;le; 0 &amp;rarr; Permanent Socket Blacklist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#7f1d1d;" parent="1" vertex="1"><mxGeometry x="980" y="370" width="250" height="80" as="geometry" /></mxCell><mxCell id="af_box" value="Swarm-Wide Non-Repudiation &amp; Anti-Framing Defense Layer" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontStyle=1;fontSize=12;startSize=25;fontColor=#b45309;rounded=1;" parent="1" vertex="1"><mxGeometry x="40" y="480" width="1200" height="190" as="geometry" /></mxCell><mxCell id="af1" value="📢 Broadcast CORRUPTION_ALERT&#10;Downloader sends:&#10;&amp;bull; Corrupted Chunk C_k&#10;&amp;bull; Provider's Signed Receipt &amp;Sigma;_prov" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#1e3a8a;" parent="af_box" vertex="1"><mxGeometry x="30" y="45" width="250" height="110" as="geometry" /></mxCell><mxCell id="af2" value="👀 Witness Peers Audit Receipt:&#10;Did accused Provider&#10;really sign &amp;Sigma;_prov?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#78350f;" parent="af_box" vertex="1"><mxGeometry x="350" y="45" width="230" height="110" as="geometry" /></mxCell><mxCell id="af3" value="🔒 Genuine Corruption Verified (Valid Provider Signature):&#10;&amp;bull; Accused provider cannot deny delivering the bad chunk (non-repudiation)&#10;&amp;bull; All swarm peers enforce quarantine &amp; apply -25 penalty globally&#10;&amp;bull; Swarm is protected against poisoning in milliseconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#7f1d1d;" parent="af_box" vertex="1"><mxGeometry x="650" y="40" width="520" height="60" as="geometry" /></mxCell><mxCell id="af4" value="🛡️ Malicious Framing / Slander Detected (Forged / Invalid Signature):&#10;&amp;bull; Alert rejected immediately as an attempted framing attack&#10;&amp;bull; Downloader penalized for slander (-25 trust penalty)&#10;&amp;bull; Honest seeders cannot be framed by malicious peers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#78350f;" parent="af_box" vertex="1"><mxGeometry x="650" y="110" width="520" height="60" as="geometry" /></mxCell><mxCell id="e1" value="Root Published" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#334155;" parent="1" source="s1" target="s2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Encrypted Transfer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#334155;" parent="1" source="s2" target="s3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Hash Check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#334155;" parent="1" source="s3" target="s4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="Valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10b981;fontSize=11;fontColor=#10b981;" parent="1" source="s4" target="v1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Success" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10b981;fontSize=11;fontColor=#10b981;" parent="1" source="v1" target="v2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Corrupt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#ef4444;fontSize=11;fontColor=#ef4444;" parent="1" source="s4" target="c1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Penalize" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#ef4444;fontSize=11;fontColor=#ef4444;" parent="1" source="c1" target="c2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Trigger Alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d97706;fontSize=11;fontColor=#d97706;" parent="1" source="c2" target="af1" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="Audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#334155;fontSize=11;fontColor=#334155;" parent="1" source="af1" target="af2" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Valid Sig" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#ef4444;fontSize=11;fontColor=#ef4444;" parent="1" source="af2" target="af3" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="Forged Sig" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d97706;fontSize=11;fontColor=#d97706;" parent="1" source="af2" target="af4" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>