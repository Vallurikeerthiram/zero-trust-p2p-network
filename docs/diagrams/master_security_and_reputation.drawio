<mxfile host="app.diagrams.net" version="24.0.0" type="device"><diagram id="sec_rep" name="Security and Reputation"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="650"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s1" value="File Ingestion&#10;(64 KB Chunks)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="40" y="40" width="160" height="50" as="geometry" /></mxCell><mxCell id="s2" value="RFC 6962 Merkle Tree&#10;(Odd Promotion)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="240" y="40" width="180" height="50" as="geometry" /></mxCell><mxCell id="s3" value="File Root Hash (R_F)&#10;(Unique Fingerprint)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="460" y="40" width="180" height="50" as="geometry" /></mxCell><mxCell id="s4" value="P2P Chunk Transmission&#10;(Chunk + Proof + Signed Receipt)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="430" y="125" width="240" height="50" as="geometry" /></mxCell><mxCell id="s5" value="Volatile RAM Buffer&#10;(Pre-Commit Barrier, 0 Bytes to Disk)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=12;fontFamily=Helvetica;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="720" y="125" width="260" height="50" as="geometry" /></mxCell><mxCell id="chk" value="Audit Check:&#10;Reconstructed Root&#10;== Expe